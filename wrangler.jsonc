{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nada-nusantara",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
