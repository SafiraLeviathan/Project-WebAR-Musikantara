{
  "name": "musikantara-webar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:sync": "node scripts/sync-assets.mjs",
    "predev": "npm run assets:sync",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run assets:sync",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "hono": "4.13.18",
    "mind-ar": "1.2.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.150.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.150.1",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.160.1"
  }
}
